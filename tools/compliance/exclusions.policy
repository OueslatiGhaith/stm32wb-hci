# stm32wb-compliance exclusion policy, format version 2.
#
# Generated coverage exclusions are:
#   scope|wire-code|firmware-selector|reason
# Transport-only events with external payload evidence are:
#   transport-event|wire-code|firmware-selector|payload-envelope|reason
#
# scope: command or event
# payload-envelope: fixed:N or bounded:MIN..=MAX, excluding the two-byte vendor event code
# wire-code: a 16-bit hexadecimal code (for example 0x9200)
# firmware-selector: * for every declared firmware, or one exact version
#                    (for example 0.17.0 or v1.17.0)
# reason: non-empty, reviewable explanation. A literal `|` is not supported.
#
# The checker rejects duplicate/overlapping selectors, unknown firmware versions,
# and entries that no longer suppress a real difference. Keep exceptions narrow.
version = 2

# This event is emitted by the coprocessor transport but is not listed in the
# generated STM32CubeWB `hci_vs_event_table` catalog.
transport-event|0x9200|*|fixed:1|transport-only coprocessor-ready event (not in CubeWB auto source)
